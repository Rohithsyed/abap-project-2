@Metadata.layer: #CORE
annotate entity ZC_SF_HISTORY with
{
  @UI.lineItem: [{ position: 10, label: 'Old Status' }]
  OldStatus;

  @UI.lineItem: [{ position: 20, label: 'New Status' }]
  NewStatus;

  @UI.lineItem: [{ position: 30, label: 'Action' }]
  ActionName;

  @UI.lineItem: [{ position: 40, label: 'Changed By' }]
  ChangedBy;

  @UI.lineItem: [{ position: 50, label: 'Changed At' }]
  ChangedAt;

  @UI.lineItem: [{ position: 60, label: 'Remarks' }]
  Remarks;
}